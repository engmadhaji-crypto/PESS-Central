NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000

# Use a dedicated MySQL database with a least-privilege account.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pess
DB_USER=pess_app
DB_PASSWORD=replace-with-a-long-random-password
DB_CONNECTION_LIMIT=10

# Generate a random 32+ byte secret. Never commit the real value.
SESSION_SECRET=replace-with-64-hex-characters
PIN_HASH_MEMORY_KIB=65536
PIN_HASH_TIME_COST=3
PIN_HASH_PARALLELISM=1
PIN_MAX_ATTEMPTS=5
PIN_LOCK_MINUTES=15

# Optional security webhook. Do not include customer data in webhook payloads.
SECURITY_WEBHOOK_URL=
SECURITY_WEBHOOK_SECRET=
